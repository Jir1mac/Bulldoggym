# ===== Bulldoggym – konfigurace prostředí =====

# --- Databáze (PostgreSQL) ---
DATABASE_URL="postgresql://USER:HESLO@localhost:5432/bulldoggym"

# --- Admin přihlášení ---
# Uživatelské jméno pro admin panel
ADMIN_USER="admin"

# Bcrypt hash hesla
ADMIN_PASS_HASH="vygenerovany_hash"

# --- Prostředí ---
NODE_ENV="production"
