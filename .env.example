# ===== Bulldoggym – konfigurace prostředí =====

# --- Databáze (PostgreSQL) ---
DATABASE_URL="postgresql://USER:HESLO@localhost:5432/bulldoggym"

# --- Admin přihlášení ---
# Uživatelské jméno pro admin panel
ADMIN_USER="admin"

# Bcrypt hash hesla (vygeneruj přes: npx tsx scripts/hash-password.ts)
# Důležité: znak $ musí být escapován jako \$ (skript to dělá automaticky)
ADMIN_PASS_HASH="sem_vloz_vygenerovany_hash"

# --- Prostředí ---
NODE_ENV="production"
