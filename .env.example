# Bcrypt hash hesla (vygeneruj přes: npx tsx scripts/hash-password.ts TVOJE_HESLO)
# Výchozí hash odpovídá heslu "bulldog2026":
ADMIN_PASS_HASH="$2b$12$QWoWUFoEdndAR4agYu8aoOHmOi2HB2J1dQj6VtCr.Kuf4SVY.vmJ."

# --- Prostředí ---
NODE_ENV="production"
